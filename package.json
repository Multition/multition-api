{
  "name": "multition-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:migrate:prod": "node dist/cli/migrate.js",
    "contracts:lint": "redocly lint openapi/*.yaml",
    "contracts:generate": "openapi-typescript openapi/openapi.yaml -o openapi/generated/core-api.d.ts && openapi-typescript openapi/ai-service.yaml -o src/clients/generated/ai-service.d.ts",
    "contracts:check": "npm run contracts:lint && npm run contracts:generate",
    "contracts:sync": "npm run contracts:generate && node scripts/sync-contracts.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@redocly/cli": "^2.11.1",
    "openapi-typescript": "^7.10.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
